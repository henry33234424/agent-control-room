    "@control-room/shared-types": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "^11.0.0",
    "@prisma/client": "^6.9.0",
    "fastify": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
