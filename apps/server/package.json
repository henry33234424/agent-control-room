{
  "name": "@control-room/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:migrate": "node scripts/prisma-with-dotenv.mjs migrate dev --schema ../../prisma/schema.prisma",
    "prisma:generate": "node scripts/prisma-with-dotenv.mjs generate --schema ../../prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.81",
    "@control-room/git-worktree": "workspace:*",
    "@control-room/runtime-events": "workspace:*",
    "@control-room/shared-types": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "^11.0.0",
    "@prisma/client": "^6.9.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.3.0",
    "node-pty": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  }
}
