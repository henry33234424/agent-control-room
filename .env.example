# Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Codex / OpenAI
OPENAI_API_KEY=sk-xxxxx

# Server
PORT=3002
DATABASE_URL=file:../data/room.db
CORS_ORIGIN=http://localhost:3005

# Models (optional — leave empty for CLI defaults)
# CLAUDE_MODEL=sonnet          # sonnet, opus, haiku, or full model ID
# CODEX_MODEL=o3               # o3, o4-mini, etc.

# Adapter mode: cli (default) or sdk
# ADAPTER_MODE=cli

# Web
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_WS_URL=ws://localhost:3002/ws
