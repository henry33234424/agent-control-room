generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Room {
  id            String   @id @default(cuid())
  name          String
  repoPath      String   @map("repo_path")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions           AgentSession[]
  chatMessages       ChatMessage[]
  pinnedBriefItems   PinnedBriefItem[]
  pinnedBriefHistory PinnedBriefHistory[]

  @@map("rooms")
}

model AgentSession {
  id              String   @id @default(cuid())
  roomId          String   @map("room_id")
  agent           String   // 'claude' | 'codex'
  vendorSessionId String?  @map("vendor_session_id")
  name            String
  status          String   @default("idle") // idle/running/failed/archived
  metadataJson    String?  @map("metadata_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  room         Room          @relation(fields: [roomId], references: [id])
  interactiveTerminalState InteractiveTerminalState?
  chatMessages ChatMessage[]

  @@map("agent_sessions")
}

model InteractiveTerminalState {
  sessionId     String   @id @map("session_id")
  active        Boolean  @default(false)
  snapshotJson  String?  @map("snapshot_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("interactive_terminal_states")
}

model ChatMessage {
  id               String   @id @default(cuid())
  roomId           String   @map("room_id")
  sessionId        String?  @map("session_id")
  agent            String?
  role             String   // user/agent/system/approval/handoff-summary/excerpt
  mentionTarget    String?  @map("mention_target")
  replyToMessageId String?  @map("reply_to_message_id")
  content          String
  contentFormat    String   @default("markdown") @map("content_format")
  selectable       Boolean  @default(true)
  pinned           Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  room         Room          @relation(fields: [roomId], references: [id])
  agentSession AgentSession? @relation(fields: [sessionId], references: [id])

  @@map("chat_messages")
}

model PinnedBriefItem {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  section   String   // goal/constraints/decisions/openQuestions/doNotTouch
  content   String
  sortOrder Int      @default(0) @map("sort_order")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id])

  @@map("pinned_brief_items")
}

model PinnedBriefHistory {
  id         String   @id @default(cuid())
  roomId     String   @map("room_id")
  itemId     String   @map("item_id")
  section    String
  content    String
  sortOrder  Int      @map("sort_order")
  version    Int
  changeType String   @map("change_type") // created/updated/reordered/deleted
  changedAt  DateTime @default(now()) @map("changed_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([roomId, changedAt])
  @@map("pinned_brief_history")
}
